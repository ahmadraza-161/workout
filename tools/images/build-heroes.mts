import { mkdirSync, readdirSync, writeFileSync } from 'node:fs';
import { join } from 'node:path';
import sharp from 'sharp';

const root = join(import.meta.dirname, '../..');
const dir = join(root, 'assets/images/heroes');
mkdirSync(join(dir, 'optimized'), { recursive: true });
const entries: string[] = [];
for (const name of readdirSync(dir).filter((name) => name.endsWith('.png')).sort()) {
  const input = join(dir, name);
  const meta = await sharp(input).metadata();
  const stats = await sharp(input).stats();
  if (!meta.hasAlpha || stats.channels[3]?.min !== 0) throw new Error(`Non-transparent hero: ${name}`);
  await sharp(input).trim().resize({ width: 768, height: 1024, fit: 'inside' })
    .png({ palette: true, quality: 90, effort: 7 }).toFile(join(dir, 'optimized', name));
  entries.push(`  '${name.slice(0, -4)}': require('../../../assets/images/heroes/optimized/${name}'),`);
}
writeFileSync(join(root, 'src/modules/content/heroImages.generated.ts'),
  `// Generated by tools/images/build-heroes.mts.\nexport const HERO_IMAGES = {\n${entries.join('\n')}\n} as const;\n`);
console.log(`Built ${entries.length} transparent hero images.`);
