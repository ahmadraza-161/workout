import { existsSync, mkdirSync, readFileSync, readdirSync, statSync, writeFileSync } from 'node:fs';
import { join } from 'node:path';

import sharp from 'sharp';

const ROOT = join(import.meta.dirname, '..', '..');
const SOURCE_DIR = join(ROOT, 'assets', 'images', 'exercises');
const OUTPUT_DIR = join(SOURCE_DIR, 'optimized');
const CUTOUT_DIR = join(SOURCE_DIR, 'cutouts');
const REALISTIC_DIR = join(SOURCE_DIR, 'realistic');
const MANIFEST = join(ROOT, 'src', 'modules', 'content', 'exerciseImages.generated.ts');
const TARGET_WIDTH = 768;
const JPEG_QUALITY = 78;

const ALIASES: Record<string, string> = {
  ex_standard_push_up: 'Athlete_performing_push-up_pose_20260929164203.jpg',
  ex_wide_push_up: 'Athlete_performing_wide_push-up_20260929164203.jpg',
  ex_diamond_push_up: 'Athlete_performing_diamond_push-up_20260929164202.jpg',
  ex_triceps_dip_chair_floor: 'Athlete_performing_triceps_dip_20260929164202.jpg',
  ex_overhead_press_isometric: 'Athlete_performing_overhead_pres…_20260929164202.jpg',
  ex_heel_digs: 'Athlete_performing_heel_digs_20260929164203.jpg',
  ex_skater_hop: 'Athlete_performing_skater_hop_pose_20260929164202.jpg',
  ex_shadow_boxing: 'Athlete_shadow_boxing_in_stance_20260929164202.jpg',
  ex_standing_knee_to_elbow: 'Athlete_performing_standing_knee…_20260929164203.jpg',
};

const pack = JSON.parse(readFileSync(join(ROOT, 'assets', 'data', 'content-pack.json'), 'utf8')) as {
  exercises: { id: string }[];
};
const sourceNames = readdirSync(SOURCE_DIR).filter((name) => name.endsWith('.jpg') || name.endsWith('.png'));
const cutoutNames = existsSync(CUTOUT_DIR) ? readdirSync(CUTOUT_DIR) : [];
const realisticNames = existsSync(REALISTIC_DIR) ? readdirSync(REALISTIC_DIR) : [];
mkdirSync(OUTPUT_DIR, { recursive: true });

const entries: string[] = [];
const missing: string[] = [];
let sourceBytes = 0;
let outputBytes = 0;
let transparentCount = 0;

for (const exercise of pack.exercises) {
  const legacy = sourceNames.filter((name) => name.startsWith(`${exercise.id}.png_`));
  if (legacy.length > 1) throw new Error(`Multiple legacy images for ${exercise.id}`);
  const name = [`${exercise.id}.png`, `${exercise.id}.jpg`, legacy[0], ALIASES[exercise.id]]
    .find((candidate) => candidate && sourceNames.includes(candidate));
  const realistic = realisticNames.includes(`${exercise.id}.png`) ? `${exercise.id}.png` : undefined;
  const cutout = realistic ?? (cutoutNames.includes(`${exercise.id}.png`) ? `${exercise.id}.png` : undefined);
  if (!cutout && (!name || !sourceNames.includes(name))) {
    missing.push(exercise.id);
    continue;
  }
  // Transparent replacements take precedence; preserve the owner's originals.
  const input = cutout ? join(realistic ? REALISTIC_DIR : CUTOUT_DIR, cutout) : join(SOURCE_DIR, name!);
  const metadata = await sharp(input).metadata();
  if ((metadata.format !== 'jpeg' && metadata.format !== 'png') || !metadata.width || !metadata.height) {
    throw new Error(`Invalid exercise image: ${name}`);
  }
  sourceBytes += statSync(input).size;
  const transparent = metadata.hasAlpha ?? false;
  if (cutout && (!transparent || (await sharp(input).stats()).channels[3]?.min !== 0)) {
    throw new Error(`Cutout needs a genuinely transparent background: ${cutout}`);
  }
  if (transparent) transparentCount += 1;
  const outputName = `${exercise.id}.${transparent ? 'png' : 'jpg'}`;
  // Trim transparent padding only. Opaque images must never lose hands/feet.
  const prepared = transparent ? await sharp(input).trim({ threshold: 0, background: '#00000000' }).png().toBuffer() : input;
  const pipeline = sharp(prepared).resize({ width: TARGET_WIDTH, height: 1024, fit: 'inside', withoutEnlargement: true });
  const info = await (transparent
    ? pipeline.png({ compressionLevel: 9, palette: true, quality: 90, effort: 7 })
    : pipeline.jpeg({ quality: JPEG_QUALITY, mozjpeg: true }))
    .toFile(join(OUTPUT_DIR, outputName));
  outputBytes += info.size;
  entries.push(`  '${exercise.id}': require('../../../assets/images/exercises/optimized/${outputName}'),`);
}

writeFileSync(MANIFEST, [
  '// Generated by tools/images/build-manifest.mts. Do not edit by hand.',
  '// Static require paths let Metro bundle every exercise pose for offline use.',
  'export const EXERCISE_IMAGES: Record<string, number> = {',
  ...entries,
  '};',
  '',
].join('\n'));

console.log(`Exercise images: ${entries.length}/${pack.exercises.length} mapped; ${missing.length} missing`);
console.log(`Image size: ${(sourceBytes / 1048576).toFixed(1)} MB source -> ${(outputBytes / 1048576).toFixed(1)} MB bundled; ${transparentCount} with alpha`);
if (missing.length) console.warn(`Missing: ${missing.join(', ')}`);

const characters = join(ROOT, 'assets/images/characters');
if (existsSync(characters)) {
  const destination = join(characters, 'optimized');
  mkdirSync(destination, { recursive: true });
  for (const filename of readdirSync(characters).filter((file) => file.endsWith('.png'))) {
    const input = join(characters, filename);
    if (!(await sharp(input).metadata()).hasAlpha) throw new Error(`Character requires transparency: ${filename}`);
    await sharp(input).trim({ threshold: 0, background: '#00000000' }).resize({ width: TARGET_WIDTH, height: 1024, fit: 'inside', withoutEnlargement: true })
      .png({ compressionLevel: 9, palette: true, quality: 90, effort: 7 }).toFile(join(destination, filename));
  }
}
