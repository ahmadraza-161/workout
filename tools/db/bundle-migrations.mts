// Bundles drizzle-kit's SQL migrations into a TypeScript module the app can
// import, in the { journal, migrations } shape expected by
// drizzle-orm/expo-sqlite/migrator. This avoids an extra Babel plugin for
// importing .sql files. Run via: npm run db:generate

import { readFileSync, writeFileSync } from 'node:fs';
import { join } from 'node:path';

interface JournalEntry {
  idx: number;
  when: number;
  tag: string;
  breakpoints: boolean;
}

const ROOT = join(import.meta.dirname, '..', '..');
const DRIZZLE_DIR = join(ROOT, 'drizzle');
const OUT_FILE = join(ROOT, 'src', 'modules', 'core', 'db', 'migrations.generated.ts');

const journal = JSON.parse(readFileSync(join(DRIZZLE_DIR, 'meta', '_journal.json'), 'utf8')) as {
  entries: JournalEntry[];
};

const escape = (sql: string): string => sql.replace(/\\/g, '\\\\').replace(/`/g, '\\`').replace(/\$\{/g, '\\${');

const entries = journal.entries.map((entry) => {
  const key = `m${entry.idx.toString().padStart(4, '0')}`;
  const sql = readFileSync(join(DRIZZLE_DIR, `${entry.tag}.sql`), 'utf8');
  return `    ${key}: \`${escape(sql)}\`,`;
});

const journalLiteral = JSON.stringify(
  { entries: journal.entries.map(({ idx, when, tag, breakpoints }) => ({ idx, when, tag, breakpoints })) },
  null,
  2,
);

const output = `// GENERATED by tools/db/bundle-migrations.mts – do not edit by hand.
// Source: drizzle/*.sql. Regenerate with: npm run db:generate

const migrations = {
  journal: ${journalLiteral.replace(/\n/g, '\n  ')},
  migrations: {
${entries.join('\n')}
  },
};

export default migrations;
`;

writeFileSync(OUT_FILE, output);
console.log(`bundled ${entries.length} migration(s) into ${OUT_FILE}`);
