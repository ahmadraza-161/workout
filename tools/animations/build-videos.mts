import { createHash } from 'node:crypto';
import { copyFileSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs';
import { join } from 'node:path';

const root = join(import.meta.dirname, '../..');
const catalog = JSON.parse(readFileSync(join(import.meta.dirname, 'video-candidates.json'), 'utf8')) as {
  slug: string; exerciseId: string; originalFile: string; originalSha256: string;
  sourceGif?: string; sourceGifSha256?: string;
  playback?: { loop: boolean };
}[];
const pack = JSON.parse(readFileSync(join(root, 'assets/data/content-pack.json'), 'utf8')) as { exercises: { id: string }[] };
const coveragePath = join(import.meta.dirname, 'coverage.generated.json');
const coverage = JSON.parse(readFileSync(coveragePath, 'utf8')) as {
  totalExercises: number; animatedExerciseIds: string[]; remainingExerciseIds: string[];
};
const lottieIds = JSON.parse(readFileSync(join(import.meta.dirname, 'catalog.json'), 'utf8')) as { exerciseId: string }[];
const ids = new Set(lottieIds.map((entry) => entry.exerciseId));
const out = join(root, 'assets/videos/exercises');
mkdirSync(out, { recursive: true });
const sources = catalog.map((entry) => {
  if (ids.has(entry.exerciseId) || !pack.exercises.some((exercise) => exercise.id === entry.exerciseId) ||
    !/^[a-z0-9-]+$/.test(entry.slug) || !/^video-source\/[a-z0-9-]+\.mp4$/.test(entry.originalFile)) {
    throw new Error(`Invalid video mapping: ${entry.slug}`);
  }
  const file = join(import.meta.dirname, entry.originalFile);
  if (entry.sourceGif) {
    if (!/^gif-source\/[a-z0-9-]+\.gif$/.test(entry.sourceGif)) throw new Error(`Invalid GIF path: ${entry.slug}`);
    const gif = readFileSync(join(import.meta.dirname, entry.sourceGif));
    if (!/^GIF8[79]a$/.test(gif.toString('ascii', 0, 6)) ||
      createHash('sha256').update(gif).digest('hex') !== entry.sourceGifSha256) {
      throw new Error(`Changed or invalid source GIF: ${entry.slug}`);
    }
  }
  const bytes = readFileSync(file);
  if (bytes.toString('ascii', 4, 8) !== 'ftyp' || createHash('sha256').update(bytes).digest('hex') !== entry.originalSha256) {
    throw new Error(`Changed or invalid original MP4: ${entry.slug}`);
  }
  ids.add(entry.exerciseId);
  copyFileSync(file, join(out, `${entry.slug}.mp4`));
  return `  '${entry.exerciseId}': require('../../../assets/videos/exercises/${entry.slug}.mp4'),`;
});
writeFileSync(join(root, 'src/modules/content/videos.generated.ts'),
  `// Generated by tools/animations/build-videos.mts. Local assets only.\nexport const EXERCISE_VIDEOS: Record<string, number | undefined> = {\n${sources.join('\n')}\n};\nexport const EXERCISE_VIDEO_PLAYBACK: Record<string, { loop: boolean } | undefined> = ${JSON.stringify(Object.fromEntries(catalog.filter(item => item.playback).map(item => [item.exerciseId, item.playback])), null, 2)};\n`);
writeFileSync(join(out, 'provenance.json'), JSON.stringify(catalog, null, 2) + '\n');
coverage.animatedExerciseIds = [...ids];
coverage.remainingExerciseIds = pack.exercises.filter((exercise) => !ids.has(exercise.id)).map((exercise) => exercise.id);
writeFileSync(coveragePath, JSON.stringify(coverage, null, 2) + '\n');
console.log(`Bundled ${catalog.length} local MP4 demos; ${ids.size}/${pack.exercises.length} animated exercises.`);
