import { readFileSync, readdirSync, writeFileSync } from 'node:fs';
import { join } from 'node:path';

// Conservative inventory: include installed production dependencies, even build tooling.
// Text is copied verbatim; missing upstream notices remain visible in the audit report.
const root = process.cwd();
const read = (path: string) => readFileSync(join(root, path), 'utf8').replace(/^\uFEFF/, '').trim();
const lock = JSON.parse(read('package-lock.json')) as {
  packages: Record<string, { dev?: boolean; version?: string }>;
};
interface Notice { name: string; version: string; licence: string; source: string; texts: number[] }
const texts: string[] = [];
function addText(text: string): number {
  let index = texts.indexOf(text);
  if (index === -1) { index = texts.length; texts.push(text); }
  return index;
}
const notices: Notice[] = [];
const missing: string[] = [];
for (const [path, entry] of Object.entries(lock.packages)) {
  if (!path || entry.dev) continue;
  let pkg: { name: string; version: string; license?: string; repository?: string | { url?: string } };
  try { pkg = JSON.parse(read(`${path}/package.json`)); } catch { continue; } // Optional packages for other OSes.
  const files = readdirSync(join(root, path), { withFileTypes: true })
    .filter((file) => file.isFile() && /^(licen[sc]e|copying|notice)([._-]|$)/i.test(file.name))
    .map((file) => `${path}/${file.name}`).sort();
  const ids = files.map((file) => addText(read(file)));
  // The 7.3.8 npm archive omits its repository's Apache licence file.
  if (pkg.name === 'lottie-react-native' && !ids.length) {
    if (pkg.version !== '7.3.8') throw new Error('Update the vendored Lottie licence for the installed version');
    ids.push(addText(read('tools/animations/lottie-react-native-LICENSE.txt')));
  }
  if (!ids.length) missing.push(`${pkg.name}@${pkg.version}`);
  const source = typeof pkg.repository === 'string' ? pkg.repository : pkg.repository?.url ?? '';
  notices.push({ name: pkg.name, version: pkg.version, licence: pkg.license ?? '', source, texts: ids });
}
const licences = read('DOC/LICENSES.md');
const animationCredits = JSON.parse(read('tools/animations/catalog.json')) as {
  creator: string; title: string; page: string; license: string;
}[];
for (const credit of animationCredits) {
  notices.push({ name: `${credit.creator} — ${credit.title}`, version: '', licence: credit.license,
    source: credit.page, texts: [addText(read('tools/animations/LICENSE.txt'))] });
}
notices.push({ name: 'Lottie Android', version: '6.7.1', licence: 'Apache-2.0',
  source: 'https://github.com/airbnb/lottie-android/tree/v6.7.1',
  texts: [addText(read('tools/animations/lottie-android-LICENSE.txt'))] });
const mapText = licences.match(/```text\s*\n([\s\S]*?)\n```/)?.[1];
if (!mapText) throw new Error('Missing vendored muscle-map notice');
notices.unshift(
  { name: 'Poppins', version: '', licence: 'SIL Open Font License 1.1',
    source: 'https://github.com/itfoundry/Poppins', texts: [addText(read('assets/fonts/OFL.txt'))] },
  { name: 'Muscle map path data', version: '', licence: 'MIT',
    source: 'https://github.com/HichamELBSI/react-native-body-highlighter', texts: [addText(mapText.trim())] },
);
const unique = [...new Map(notices.map((notice) => [`${notice.name}@${notice.version}`, notice])).values()];
writeFileSync(join(root, 'assets/data/notices.generated.json'), JSON.stringify({ notices: unique, texts }, null, 2) + '\n');
writeFileSync(join(root, 'DOC/LICENSE_AUDIT.md'), `# Installed dependency notice audit\n\nGenerated by \`npm run licenses:build\` from the installed lockfile. Includes production dependencies and their build tooling; this is a conservative inventory, not a claim that every package ships in the Android bundle.\n\n${unique.length} entries; ${missing.length} installed packages omit a top-level licence/notice file. Their declared licence and repository are preserved in the app. Verify upstream notices and native libraries before release.\n\n${missing.map((name) => `- ${name}`).join('\n')}\n\n## Revision history\n\n| Version | Date | Changes |\n|---|---|---|\n| 1.0 | Sep 30, 2026 | Generated installed notice inventory and missing-file follow-up list |\n`);
console.log(`Bundled ${unique.length} notice entries; ${texts.length} unique texts; ${missing.length} upstream notice checks remain.`);
